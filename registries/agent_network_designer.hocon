{
    "metadata": {
        "description": "Multi-agent system designed to create or modify other multi-agent systems. It first DELIBERATES: it looks up curated knowledge for the requested domain, interviews you one question at a time - each as a numbered list of options you answer by number, with an escape for 'not sure' and no guessing when your answer fits more than one - and presents a design brief separating what you confirmed from what it assumed. You can say 'go back' at any point before the build to change an earlier answer, as far back as the first question, without losing the answers you kept. Only once you approve does it build the network, save it to registries in HOCON format, add it to the manifest, and generate example usage queries - with each operating standard embedded verbatim, and traceable by id, in the agent that owns it.",
        "tags": ["experimental", "tool"],
        "sample_queries": [
            "Build me an agent network for Oracle db patching",
            "Build me an agent network to upgrade our Kubernetes clusters",
            "Build me an agent network for our clinical trial database lock process",
            "Build me an agent network for pizza delivery"
        ]
    },

    include "registries/expertise_scoping_instructions.hocon",

    # Load the shared LLM configuration from a single source of truth.
    # This allows users to change the model in one file rather than
    # modifying the configuration for each agent network.
    # Note that the file path here is relative to the root level of the repo.
    include "config/llm_config.hocon",
    "max_steps": 40000,
    "max_execution_seconds": 6000,
    "error_formatter": "json",
    "error_fragments": ["Error:", "Exception:", "Traceback (most recent call last)"],

    # Regex fragments used by the PIIMiddleware detector on the front-man agent below.
    # Each fragment targets one credential shape; the detector concatenates them into a
    # single alternation via HOCON substitution. Prefix-anchored patterns use `+` (no
    # length floor) because the prefix itself is a strong signal — we'd rather redact a
    # suspiciously-short match than miss a real leak (e.g. `sk-ant-ajdslkfj` should still
    # be caught).
    "pii_patterns": {
        # Anthropic API keys (e.g. sk-ant-api03-...)
        # NOTE: each "sk-" pattern is guarded by (?<![A-Za-z0-9]) so it only fires at the start of a
        # token. Without it, the bare "sk-" alternation matches INSIDE ordinary words - "risk-based",
        # "task-based", "disk-backed" - and redacts them mid-sentence as if they were API keys
        # (observed live: "risk-based SDV" rendered as "ri[REDACTED_API_KEY] SDV"). A real key is never
        # preceded by a word character, so the guard costs no detection.
        "anthropic":    "(?<![A-Za-z0-9])sk-ant-[A-Za-z0-9_-]+",
        # OpenAI project keys (e.g. sk-proj-...)
        "openai_proj":  "(?<![A-Za-z0-9])sk-proj-[A-Za-z0-9_-]+",
        # OpenAI classic keys (e.g. sk-...)
        "openai":       "(?<![A-Za-z0-9])sk-[A-Za-z0-9_-]+",
        # AWS access key IDs — fixed 20 chars (e.g. AKIAIOSFODNN7EXAMPLE)
        "aws":          "AKIA[0-9A-Z]{16}",
        # Google API keys — fixed 39 chars (e.g. AIzaSy...)
        "google":       "AIza[0-9A-Za-z_-]{35}",
        # GitHub tokens (ghp_, gho_, ghu_, ghs_, ghr_)
        "github":       "gh[pousr]_[A-Za-z0-9]+",
        # Slack tokens (xoxb-, xoxa-, xoxp-, xoxr-, xoxs-)
        "slack":        "xox[baprs]-[A-Za-z0-9-]+",
        # GitLab personal access tokens
        "gitlab":       "glpat-[A-Za-z0-9_-]+",
        # Stripe secret keys (sk_live_..., sk_test_...)
        "stripe":       "sk_(?:live|test)_[A-Za-z0-9]+",
        # Bearer tokens in Authorization-style headers.
        # Kept at 20+ chars because "Bearer x" is common in prose.
        "bearer":       "Bearer\\s+[A-Za-z0-9._~+/=-]{20,}",
        # HOCON env-var substitution attempts, both required ${VAR} and optional ${?VAR}
        # forms (the `?` falls under `[^}]+`). An agent that emits either into constructed
        # HOCON would exfiltrate whatever env var the server later resolves — redact
        # before it can be written to disk.
        "env_var":      "\\$\\{[^}]+\\}"
    },

    # ---------------------------------------------------------------------------
    # CURATED DOMAIN KNOWLEDGE
    #
    # No longer inline. Each domain is a folder of .md documents under
    #   coded_tools/agent_network_designer/knowdocs/<domain>/
    # read by the ExtractDocs coded tool below - the same pattern the airline_policy
    # example uses for its policy knowdocs. Documents come back WHOLE and verbatim,
    # so an operating standard reaches the designed agents word for word with its id.
    #
    # This is the seam: today the lookup hits the local filesystem; pointing it at a
    # real knowledge layer or connector catalogue changes WHERE the documents come
    # from and nothing else about how the designer behaves.
    # ---------------------------------------------------------------------------

    "tools": [
        # This first agent definition is regarded as the "Front Man", which
        # does all the talking to the outside world/client.
        #
        # Some disqualifications from being a front man:
        #   1) Cannot use a CodedTool "class" definition
        #   2) Cannot use a Tool "toolbox" definition
        #
        # Besides the first agent being the front man, these tool definitions
        # do not have to be in any particular order. How they are linked and
        # call each other is defined within their own specs.
        # This could be a graph, potentially even with cycles.
        {
            "name": "agent_network_designer",
            "function": {
                "description": "Create or modify an agent network.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "agent_network_description": {
                            "type": "string",
                            "description": "For `create`: A full description of the project, business, or company this agent network represents. For `modify`: A clear description of the change you want to make to the existing agent network."
                        },
                        "mode": {
                            "type": "string",
                            "description": "Indicates whether to build a brand new agent network (`create`) or to edit the existing one (`modify`)."
                        }
                    },
                    "required": ["agent_network_description", "mode"]
                },

                # You can optionally specify the schema needed for any sly_data as input.
                # This is to allow generic clients to know what to expect for private-data inputs
                # that do not belong in the chat stream.
                "sly_data_schema": {
                    "type": "object",
                    "properties": {
                        "agent_network_definition": {
                            "type": "object",
                            "description": "An internal representation of the agent network used for further iteration."
                        },
                        "agent_network_hocon_file": {
                            "type": "string",
                            "description": """
The path of an agent network config file. HOCON (.hocon) is preferred — hence the field name — but JSON (.json) is also accepted. Accepted in order:
(1) an absolute path; (2) a path relative to the current working directory (typically the repo root, e.g. 'registries/generated/foo.hocon');
(3) a path relative to the registries folder — the directory of the first file in the AGENT_MANIFEST_FILE env var, falling back to 'registries' in the repo root.
This is for users who want to provide the full agent network definition as input.
"""
                        },
                        "agent_network_name": {
                            "type": "string",
                            "description": "The name of the agent network that was created or modified."
                        },
                        "agent_reservations": {
                            "type": "array",
                            "description": """
A list of reservation structures describing the temporary agent networks that were created by interacting
with this agent. By convention, the last one in the list is a top-level handle which may reference any others listed.
""",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "reservation_id": {
                                        "type": "string",
                                        "description": """
The unique identifier of the reserved temporary agent network.
This can be used to invoke the newly created network later on the same server/cluster.
"""
                                    }
                                }
                            }
                        },
                        "skip_designer": {
                            "type": "boolean",
                            "description": "Use this key when you want to persist the agent network definition without having the LLM make any modifications."
                        }
                    }
                    # Note: Neither of these fields are strictly required in order to kick off creating a new network.
                },

                # You can also optionally specify the schema needed for any sly_data output.
                # This is to allow generic clients to know what to expect for private-data outputs
                # that do not belong in the chat stream.
                "sly_data_output_schema": {
                    "type": "object",
                    "properties": {
                        "agent_network_definition": {
                            "type": "object",
                            "description": "An internal representation of the agent network used for further iteration."
                        },
                        "agent_network_hocon_text": {
                            "type": "string",
                            "description": "The contents of an agent network HOCON file describing the created network"
                        },
                        "agent_network_name": {
                            "type": "string",
                            "description": "The name of the agent network that was created or modified."
                        },
                        "agent_reservations": {
                            "type": "array",
                            "description": """
A list of reservation structures describing the temporary agent networks that were created by interacting
with this agent. By convention, the last one in the list is a top-level handle which may reference any others listed.
""",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "reservation_id": {
                                        "type": "string",
                                        "description": """
The unique identifier of the reserved temporary agent network.
This can be used to invoke the newly created network later on the same server/cluster.
"""
                                    },
                                    "lifetime_in_seconds": {
                                        "type": "float",
                                        "description": """
Approximate lifetime (in seconds) of the temporary agent network reservation suitable for reporting to end users.
"""
                                    },
                                    "expiration_time_in_seconds": {
                                        "type": "float",
                                        "description": """
The number of seconds since the epoch (Jan 1, 1970) when the reservation will expire.
After this time the network can no longer be counted upon to exist.
"""
                                    }
                                }
                            }
                        }
                    },
                    # Note: "agent_reservations" is not strictly required depending on env vars.
                    "required": ["agent_network_definition", "agent_network_hocon_text", "agent_network_name"]
                }
            },
            "instructions": ${expertise_scoping_instructions} """
You are responsible for designing and modifying agent networks based on user requirements.
You work in two phases and you never mix them.

=== PHASE A - DELIBERATE ===
In Phase A you build nothing: agent_network_editor, agent_network_instructions_editor and
agent_network_query_generator are forbidden until Phase B opens. A network built on guesses is worse than
no network, so gathering the requirements IS the work in this phase. Three tools ARE allowed here, because
they inform the questions rather than skip them: ListDomains, ExtractDocs, InterviewLog (all below)
and web_search. InterviewLog builds nothing - it holds the interview and hands you the next question.

THE STEP LABELS BELOW (A1, A2, ...) ARE INTERNAL. Never print a label, never quote one of these
instructions back, and never narrate which step you are on. The user must see only the question itself,
or the brief. Write as a consultant talking to a colleague, not as a system following a checklist.

    WRONG: "A3. Ask the open variables ONE AT A TIME. Question: <the open variable's question>"
    RIGHT: "<The question, phrased the way a colleague would ask it>?
              1. <the variable's first example answer>
              2. <its second>
              3. Something else - I will describe it
              4. I am not sure - choose a sensible default for me

            <Its why-clause, as one short clause.>
            Reply with a number, or in your own words. Say "go back" to change an earlier answer."

The placeholders above are deliberate: a worked example in a real domain would teach you that
domain's vocabulary, and you would carry it into every other one. Fill them from the curated
document in front of you, never from this instruction.

A1. Call ListDomains to find out which curated domains this deployment actually has. Never assume a
    domain exists without listing first - what is available differs between deployments. Then decide
    which of the listed domains the request belongs to, matching on what the work actually is rather
    than on the words used.
A2. If a domain matches, ALWAYS call ExtractDocs (app_name: "<that domain>") to get the curated
    knowledge, before asking anything. Use ONLY the operating standards and open variables in the
    returned documents:
    - the OPERATING STANDARDS are non-negotiable and are quoted verbatim, with their ids, wherever you
      refer to them - never paraphrase one, never invent one, never renumber one;
    - the OPEN VARIABLES are your question list, asked in the order given - by InterviewLog, which
      reads them from the same pack rather than from anything you remember about them.
    Open with one line restating the request and naming the domain you matched.

    If no domain matches, or ExtractDocs returns an error, say so plainly in one sentence - "I have no
    curated knowledge for this domain, so this network will be built on general knowledge only and its
    standards are not verified" - name the domains that ARE available, then derive four to six questions
    of your own and continue, asking them in the same numbered form as below. Never present your own
    general knowledge as a curated standard, and never interview from a domain you did not actually match.
A3. Call InterviewLog (action: "start", app_name: "<the domain you matched>") and print the "prompt" it
    returns VERBATIM as your question. Then, for every user reply, call InterviewLog again and print the
    "prompt" it returns. That tool holds the interview: the question list, the answers, which question is
    on screen, and where a request to go back lands.

    You do NOT keep the answer log yourself, and you do not compose the questions. This is the same
    division as the coverage table in Phase B: bookkeeping you would have to remember perfectly across a
    long conversation is computed instead, and you print the computed result. A remembered log drifts -
    an entry gets relabelled, an earlier answer is quietly rewritten to agree with a later one, "back
    three" lands on the wrong question - and every one of those failures is silent.

    So: never invent a question, never renumber the options, never re-word an option, and never carry an
    answer forward that you did not send to InterviewLog. If you find yourself writing out the list of
    what the user has told you so far, you are keeping a second log that will disagree with the first.
A4. Pass the user's reply to InterviewLog (action: "answer", reply: "<what they said, VERBATIM>"). Send
    their words unedited - tidying "service now CR" into the option you think they meant is the assumption
    the tool exists to catch, and it cannot catch what it is not shown.

    Then do what the returned "status" says, and nothing else:
    - "recorded"  - the answer is on file. Print the "prompt": it is the next question.
    - "complete"  - every open variable is answered. Go to the brief.
    - "ambiguous" - the reply fits more than one of the options offered and chose between none of them.
                    The variable is STILL OPEN. Print the "prompt", which asks again with only the
                    options it could have meant. Do not record it, do not default it, do not move on,
                    and do not name one of the candidates back as though it had been chosen.
    - "describe"  - they took the "something else" option without saying what. Print the "prompt".
    - "assume"    - they do not know and want a default. See A5.
    - "choose" / "unknown" - a request to go back that named no single entry. Print the "prompt".
A5. When the status is "assume", or the user says they do not know or asks you to assume for ONE variable:
    choose a sensible default yourself - the tool cannot, because a default is a domain fact and it holds
    none - and record it with InterviewLog (action: "assume", default: "<the default you chose>"). State
    the default in one line. It is then logged as ASSUMED, which is what keeps it out of the brief's
    confirmed requirements, so never record a default through action "answer" instead.
    If the user asks you to assume defaults GENERALLY ("assume sensible defaults", "you decide", "use
    your judgement"), do the same for every remaining open variable, one "assume" call each, then go
    straight to the brief with each one listed as an assumption.
A6. The user may CHANGE AN EARLIER ANSWER at any time before the build - from any question, and from the
    brief. An interview that only moves forward makes the first mistyped answer unfixable except by
    starting over, so treat going back as an ordinary part of the interview, never as an interruption.

    When a reply asks to go back rather than answering - "go back", "back three", "change question 3",
    "change what I said about <topic>", "take me back to the first question" - call InterviewLog
    (action: "back", target: "<their words, VERBATIM>") and print the "prompt". Pass their words rather
    than your reading of them: the tool resolves a count, a label and a topic, and when a count and a
    topic disagree it asks the user instead of picking, which it can only do if it sees both.

    Do NOT answer the question on screen from a reply that asked to go back, and do not treat it as a
    request to skip anything. There is no limit on how far back or how many times; going further back
    than the first question lands on the first.

    What comes back is the answer log plus that question re-asked, with the recorded answer marked
    "(currently on file)". Every other answer is untouched, and after the new answer the tool resumes at
    the first variable still unanswered, so nothing in between is asked twice. Say in one line what
    changed before you carry on, so the correction is visible rather than silent.

    One thing the tool cannot do is read your domain: if the new answer CONTRADICTS a later answer
    already on file, only you can see that. Say so, and go back for that entry too.
A7. When the questions are done, take the brief's two answer sections from InterviewLog, not from your
    memory of the conversation. Its last reply already carried them: "confirmed" is the list for
    "Confirmed requirements", "assumed" is the list for "Assumptions I made". Call it once more
    (action: "log") if you need them again. Copy the lines as given.

    This is not tidiness. The brief is the document the user reads and approves, and if an answer they
    went back and CORRECTED reaches it with the old value, going back will have appeared to work while
    the mistake it was meant to fix gets approved. Recalling twelve turns of answers is exactly the task
    you cannot be relied on for, and the tool has each one on file exactly once.

    Then present the DESIGN BRIEF as markdown, in exactly this shape. Write each
    heading ONCE and list its items as bullets underneath - never repeat the heading text at the start of
    every line, and never run the items together into a paragraph. A human has to be able to skim this
    and spot what you assumed.

    ## DESIGN BRIEF - <CamelCaseNetworkName>

    **Scope**
    One or two sentences: what this network automates, and what it deliberately does not.

    **Confirmed requirements** _(what you told me)_
    - Topology: <answer>
    - <next item>

    **Operating standards enforced** _(from curated knowledge)_
    - **<ID>** - <the standard, verbatim from the curated document>
    - **<ID>** - <...>

    **Assumptions I made** _(tell me if any are wrong)_
    - <item>: <the default I used>

    **Out of scope**
    - <item>   (if genuinely nothing, write "Nothing identified")

    **Proposed network shape**
    - Top: <agent_name>
    - Then: <agent_name>, <agent_name>
    - Leaves: <agent_name>, <agent_name>

    Rules for the brief:
    - Every section is filled in: never emit a placeholder, a bracketed hint, or an empty heading.
    - The `[user]` / `[assumed]` tags are NOT printed - the section a line sits in already says which it
      is. An item you assumed belongs ONLY under "Assumptions I made" and must never also appear under
      "Confirmed requirements". You do not have to judge which section a line belongs in: InterviewLog
      already separated them, because it recorded which answers came from the user and which were
      defaults you chose.
    - Keep each bullet to one line where you can. Standards are the exception: they are quoted verbatim
      however long they are, because their wording is the point.
    - Use the real agent names in the shape, named for the work they do in this domain.

A8. End your Phase A reply with exactly this line and nothing after it:
    Reply APPROVED to build this, tell me what to change, or say "go back" to revisit an answer.

If at any point the user tells you to skip the questions and just build it, do not comply. Name the
smallest set of questions still open (at most three), explain in one sentence what would be wrong in the
network if you guessed them, and ask again. Going back to an earlier answer is NOT skipping and is never
refused - one asks you to build on less, the other asks you to build on something more accurate.

=== PHASE B - BUILD ===
Phase B opens only once the user has replied APPROVED, or has approved in equivalent words.

Carry the DESIGN BRIEF into the build: whenever you call agent_network_editor or
agent_network_instructions_editor, pass the FULL brief text as agent_network_description, so the
confirmed topology, window and approval route and the operating standards reach every agent that is
written. Where a standard is a precondition - a backup, a document review, a version check - create the
gate agent that enforces it before the work agent runs; where it is a post-condition, create the agent
that performs it afterwards.

The agent that writes instructions only ever sees the text you pass it, so the formatting rule has to
travel WITH the brief, not stay in your head. Append this block verbatim to the end of every
agent_network_description you send to agent_network_editor and agent_network_instructions_editor, with
the standards list filled in from the curated documents:

    INSTRUCTION-WRITING REQUIREMENT (must be honoured for every agent you write):
    Each operating standard below is owned by exactly one agent. In that agent's instructions, reproduce
    its standard VERBATIM on its own line, prefixed with "MUST:" and suffixed with its id in square
    brackets, in this shape:
        MUST: <the standard's text, exactly as written in the curated document> [<its id>]
    Do not paraphrase, shorten, merge, renumber or drop a standard, and do not add standards of your own.
    The wording and the id must survive exactly as given, so each rule stays traceable to its source.
    Standards and their owning agents:
    <one line per standard: id, verbatim text, owning agent name>

When the network is finalized, call VerifyStandards ONCE, passing the same app_name you passed to
ExtractDocs. It returns a computed coverage report. Do NOT write the coverage table yourself: you would
be certifying your own work, and you cannot see whether the agent that wrote the instructions preserved
each standard's wording. Print the returned "report" verbatim as the standards coverage section below.
If "ok" comes back false, say so in one plain sentence above the table rather than presenting the network
as complete.

Then close with a short, skimmable summary in markdown - not a wall of text:

    ## <NetworkName> - built

    **What it does**
    One or two sentences.

    **Agents**
    - `agent_name` - what it is responsible for, in one line
    - ...

    <the "report" returned by VerifyStandards, printed verbatim>

    **Where it lives**
    The path of the generated file, and the sample queries.

Take the following steps. Make sure you don't miss any details and follow the steps carefully.

LOOPABLE WORKFLOW (steps 1–3 can repeat any number of times):
You may repeat steps 1–3 (create/modify structure, refine instructions, regenerate queries) until the network is ready for finalization.

1) Create or modify the network structure
- If the user provides a company name or domain description for a new network, generate an agent network definition that mirrors relevant workflows and responsible nodes. Call your `agent_network_editor` tool. Ensure the agent network name is snake case.
- If the user asks to modify an existing network's structure (add/remove agents, or change up-chains/down-chains), call `agent_network_editor` with the modification instructions.
- You may call `web_search` to find more details on the company or domain.
- If the user only asks to modify agent instructions (no structural changes), skip structural edits and go to step 2.
- Wait for and inspect the response from `agent_network_editor` before proceeding.

2) Create or refine agent instructions
- Always call `agent_network_instructions_editor` to generate instructions after step 1 if the network structure is created.
- After structural modification, you may call `agent_network_instructions_editor` to update agents' instructions.
- You may call `agent_network_instructions_editor` multiple times as you iterate on the network; call it whenever agents are added or when their responsibilities change.
- You may call `web_search` to find more details on the company or domain.
- Wait for and inspect the response from `agent_network_instructions_editor` before proceeding.

3) Generate sample queries
- Obtain 3–4 sample queries for the current agent network by calling `agent_network_query_generator`.
- If the sample queries do not match the network or you decide further changes are needed, return to steps 1 or 2, then regenerate queries.
- You may call `agent_network_query_generator` repeatedly until the queries accurately reflect the network behavior.

Operational notes:
- Always wait for each tool's response before taking the next action.
- Iteratively refine the structure, instructions, and queries.
""",
            "allow": {
                "to_upstream": {
                    "sly_data": [
                        "agent_network_definition",
                        "agent_network_hocon_text",
                        "agent_network_name",
                        "agent_reservations",
                        # The curated pack a network is being built from. This has to be listed
                        # here or it does not survive the interview: the session's sly_data is
                        # rebuilt from the client's payload on every turn, so a key written by
                        # ExtractDocs in the first turn is discarded unless it goes out to the
                        # client and comes back. Without it the generated artifact has no record
                        # of its own ancestry.
                        "agent_network_pack_provenance",

                        # The interview itself: its questions, its answers and which question is
                        # on screen, written by InterviewLog. Listed here for the same reason as
                        # the provenance above, and it matters more. Without it the log is rebuilt
                        # empty on every turn, so the designer would re-ask the first question
                        # after every reply and no answer would ever be on file - the tool would
                        # look broken rather than absent. See coded_tools/.../interview_log.py.
                        #
                        # Deliberately NOT in "to_tracing" below: unlike the provenance line, this
                        # carries what the user said about their own estate, which is theirs and
                        # has no reason to reach an observability backend.
                        "agent_network_interview_log"
                    ]
                },
                "from_downstream": {
                    "sly_data": ["agent_network_definition", "agent_network_name", "agent_network_queries"],
                    # Allow all messages sent from specific downstream agents to be reported
                    # as if they came back from this agent network
                    "messages": ["/agent_network_editor", "/agent_network_query_generator", "/agent_network_instructions_editor"]
                },
                "to_downstream": {
                    # Optionally propagate any BYOK keys to downstream tools.
                    "sly_data": ["agent_network_definition", "agent_network_name", "agent_network_queries",
                                 ${?llm_config_key}]
                },
                "to_tracing": {
                    # These keys are not considered private and OK to send to an Observability backend
                    "sly_data": [
                        "agent_network_definition",
                        "agent_network_hocon_text",
                        "agent_network_name",
                        "agent_reservations",
                        "agent_network_pack_provenance"
                    ]
                }
            },
            "tools": ["ListDomains", "ExtractDocs", "InterviewLog", "VerifyStandards", "/agent_network_editor", "/agent_network_query_generator", "/agent_network_instructions_editor", "web_search"],
            # Parse any JSON in responses into the structure field of the ChatMessage.
            "structure_formats": "json",
            "middleware": [
                {
                    "class": "middleware.agent_network_designer.agent_network_definition_middleware.AgentNetworkDefinitionMiddleware",
                    "args": {
                        "progress_reporter": true,
                        "sly_data": true
                    }
                },
                {
                    "class": "middleware.agent_network_designer.persistence.agent_network_persistence_middleware.AgentNetworkPersistenceMiddleware",
                    "allow": {
                        "reservations": true
                    },
                    "args": {
                        "reservationist": true,
                        "sly_data": true,
                    }
                },
                {
                    # See https://docs.langchain.com/oss/python/langchain/middleware/built-in#pii-detection
                    # for details on the specific PII implementation.
                    # Redacts common API key formats and HOCON env-var lookups so secrets never reach
                    # the LLM, the client, or downstream tools. Applied to inputs, outputs, and tool
                    # results — the model itself should not see a leaked key either (otherwise it
                    # could echo, log, or summarize it back later).
                    #
                    # The `detector` regex is an alternation of the fragments defined in the
                    # top-level `pii_patterns` block above, concatenated here via HOCON substitution.
                    "class": "langchain.agents.middleware.PIIMiddleware",
                    "args": {
                        "pii_type": "api_key",
                        "detector": ${pii_patterns.anthropic}"|"${pii_patterns.openai_proj}"|"${pii_patterns.openai}"|"${pii_patterns.aws}"|"${pii_patterns.google}"|"${pii_patterns.github}"|"${pii_patterns.slack}"|"${pii_patterns.gitlab}"|"${pii_patterns.stripe}"|"${pii_patterns.bearer}"|"${pii_patterns.env_var},
                        "strategy": "redact",
                        "apply_to_input": true,
                        "apply_to_output": true,
                        "apply_to_tool_results": true
                    }
                }
            ]
        },

        {
            # The curated catalogue, read at run time from the knowdocs root rather than listed in
            # this prompt. Keeps the method layer free of domain nouns: adding a domain is dropping
            # a folder into the knowdocs root, with no edit here and no edit in Python.
            "name": "ListDomains",
            "function": {
                "description": """
Returns the curated knowledge domains available on this deployment: for each, its id, title, a short
summary of what it covers, its pack version, and how many operating standards it defines. Match on
the summary; you do not need the standards themselves to choose, and ExtractDocs returns them in full.
Call this FIRST, before deciding which domain a request belongs to. Never assume a domain exists.
If it returns an error, this deployment has no curated knowledge at all: say so plainly and continue
on general knowledge.
                """
                # No "parameters" block: this tool takes no arguments, and neuro-san rejects a
                # parameters block whose properties dict is empty (LangChainOpenAIFunctionTool
                # .verify_function_json), so declaring one would make the tool uncallable.
            },
            "class": "list_domains.ListDomains"
        },

        {
            # Curated domain knowledge, read by default from
            # coded_tools/agent_network_designer/knowdocs/<domain>/*.md - the root is configurable
            # via AGENT_NETWORK_DESIGNER_KNOWDOCS, so a deployment can serve its own packs.
            # Same pattern as the airline_policy example's ExtractDocs over its policy knowdocs:
            # documents are returned whole and verbatim, never chunked or summarized.
            "name": "ExtractDocs",
            "function": {
                "description": """
Returns the curated knowledge documents for a domain: its operating standards (each carrying a stable id)
and the open variables that must be asked before a network for that domain can be designed. Documents come
back whole and verbatim, so a standard can be quoted word for word with its id intact.
The name of the domain must be passed as a parameter, exactly as ListDomains reported it.
You MUST call ListDomains first, and you MUST call this tool before interviewing whenever the request
matches one of the domains it reported.
If the request matches none of them, do not call this tool: say you have no curated knowledge for that
domain and continue on general knowledge.
                """,
                "parameters": {
                    "type": "object",
                    "properties": {
                        "app_name": {
                            "type": "string",
                            "description": "The name of the curated domain, exactly as ListDomains reported it"
                        },
                    },
                    "required": ["app_name"]
                }
            },
            "class": "extract_docs.ExtractDocs"
        },

        {
            # The interview as state rather than as something the front man remembers. The state
            # machine is in interview_state.py and imports nothing from neuro-san, so an interview
            # can be played out in a unit test with no model at all; this entry is only how the
            # designer reaches it. Allowed in Phase A because it builds nothing - it asks.
            "name": "InterviewLog",
            "function": {
                "description": """
Holds the interview for a curated domain: the question list, every answer, which question is on screen,
and where a request to go back lands. Returns a "prompt" you print VERBATIM as your question - its options
are the pack's own example answers, in the pack's order, with "something else" and "not sure" appended.
Do not keep your own answer log and do not compose your own questions; a second log will disagree with
this one.
Call with action "start" and the app_name you passed to ExtractDocs, before asking anything. Then call it
for EVERY user reply: "answer" with their words verbatim, "back" when they ask to change an earlier
answer, "assume" with a default you chose when they say they do not know, "log" to see what is on file.
Branch on the returned "status": "recorded" and "reopened" carry the next question to print, "ambiguous"
means the reply fits several options and the variable is still open, "complete" means go to the brief.
                """,
                "parameters": {
                    "type": "object",
                    "properties": {
                        "action": {
                            "type": "string",
                            "description": "One of: start, answer, back, assume, log."
                        },
                        "app_name": {
                            "type": "string",
                            "description": "For `start`: the curated domain to interview from, exactly as ListDomains reported it."
                        },
                        "reply": {
                            "type": "string",
                            "description": "For `answer`: what the user said, verbatim and unedited. Do not tidy it into the option you think they meant."
                        },
                        "target": {
                            "type": "string",
                            "description": "For `back`: how the user named the entry, in their own words. Omit for one question back."
                        },
                        "default": {
                            "type": "string",
                            "description": "For `assume`: the sensible default you chose, recorded as an assumption rather than a confirmed answer."
                        }
                    },
                    "required": ["action"]
                }
            },
            "class": "interview_log.InterviewLog"
        },

        {
            # Computes the standards-coverage table instead of letting the model write one about
            # its own work. Deterministic: coverage, fidelity, provenance and - where the pack
            # declares temporal roles - that a gate is not also the operation it guards.
            "name": "VerifyStandards",
            "function": {
                "description": """
Verifies that the agent network just built actually carries the domain's operating standards, and returns
a computed coverage report. Checks that every standard is embedded exactly once (coverage), that its text
matches the curated document (fidelity), and that no embedded id is one the pack does not define
(provenance).
Call this ONCE, after the network is finalized and before you write your closing summary, passing the same
app_name you passed to ExtractDocs. Print the returned "report" verbatim as your standards coverage
section. If "ok" is false, state that plainly rather than claiming full coverage.
                """,
                "parameters": {
                    "type": "object",
                    "properties": {
                        "app_name": {
                            "type": "string",
                            "description": "The curated domain this network was designed for."
                        },
                        "strict": {
                            "type": "boolean",
                            "description": "Optional. When true a failed verification is returned as an error rather than a report. Defaults to false."
                        }
                    },
                    "required": ["app_name"]
                }
            },
            "class": "verify_standards.VerifyStandards"
        },

        {
            "name": "web_search",
            "toolbox": "ddgs_search"
        },

    ]
}
